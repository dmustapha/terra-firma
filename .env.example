# Terra Firma environment template. Copy to web/.env.local (local) or set on the Vercel project (prod).
# Only NEXT_PUBLIC_* values reach the browser; never put secrets in them.
# Server-only keys (GETBLOCK_RPC_FRA, GETBLOCK_RPC_NYC, GETBLOCK_WSS_FRA, ENVIO_API_TOKEN) are read by API routes only and must never be NEXT_PUBLIC_.

# WalletConnect v2 project id. Without it the wallet dialog offers only injected + Coinbase (no Robinhood Wallet / mobile).
# Obtain: create a free project at https://cloud.reown.com (formerly WalletConnect Cloud) -> copy the Project ID.
NEXT_PUBLIC_WC_PROJECT_ID=your-walletconnect-project-id

# Demo wallet whose card the landing "See a real card" button opens. Must be a real wallet with real buys.
# Obtain: the address of the seeded demo wallet (scripts/seed-demo.ts output). Leave empty to hide the button.
NEXT_PUBLIC_DEMO_ADDR=0xYourDemoWalletAddress

# Real long-history wallet for the "See a wallet with real history" link on /app and /card (PRD Scene 2).
# Optional: defaults to 0x3fDBeB0FC14cca8fDd238Dd21725F0b8585Ab09E when unset.
NEXT_PUBLIC_HISTORY_ADDR=

# Public source repo (footer "Source" + "SECURITY.md" links, /proof test-output link). No trailing slash.
# Obtain: the GitHub URL of this repository, e.g. https://github.com/<org>/<repo>
NEXT_PUBLIC_REPO_URL=https://github.com/your-org/terra-firma

# Canonical site origin for OG/metadata URLs. No trailing slash.
# Obtain: the production URL Vercel assigns (Project -> Domains), e.g. https://terra-firma.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# Friend Jars feature flag (PRD C12 / OD7). "1" enables /friends and lists FriendJar on /proof; anything else hides both.
NEXT_PUBLIC_FRIEND_JARS=0
